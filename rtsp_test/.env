# Default profile used when run_tests.py is executed without --camera-profile.
RTSP_CAMERA_PROFILE=reolink

# Optional tcpdump interface override for launch_test.sh scripts. Leave empty to keep each launcher fallback.
RTSP_TCPDUMP_INTERFACE=

# Camera profiles use the pattern <PROFILE>_RTSP_*.
# To add another camera, choose a profile name such as LAB_CAMERA, define
# LAB_CAMERA_RTSP_SERVER, LAB_CAMERA_RTSP_PORT, LAB_CAMERA_RTSP_PATH,
# LAB_CAMERA_RTSP_USER, and LAB_CAMERA_RTSP_PASSWORD, then run with
# --camera-profile lab_camera or set RTSP_CAMERA_PROFILE=lab_camera.

# Bosch camera - CNR professional industrial scenario
BOSCH_RTSP_SERVER=10.20.30.157
BOSCH_RTSP_SOURCE_IP=10.20.80.176
BOSCH_RTSP_PORT=554
BOSCH_RTSP_PATH=rtsp_tunnel
BOSCH_RTSP_USER=service
BOSCH_RTSP_PASSWORD=Babilonia11!

